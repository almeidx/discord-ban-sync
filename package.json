{
	"name": "discord-ban-sync",
	"private": true,
	"author": "Almeida <contact@almeidx.dev> (almeidx.dev)",
	"type": "module",
	"imports": {
		"#commands/*": "./src/commands/*",
		"#listeners/*": "./src/listeners/*",
		"#structures/*": "./src/structures/*",
		"#utils/*": "./src/utils/*"
	},
	"scripts": {
		"build": "tsc",
		"build:typecheck": "tsc --noEmit",
		"fmt": "oxlint --fix && oxfmt",
		"lint": "oxlint && oxfmt --check",
		"start": "node --env-file=.env src/index.ts"
	},
	"dependencies": {
		"@discordjs/core": "3.0.0-dev.1794009739-5bb74922a",
		"@discordjs/rest": "3.0.0-dev.1794009739-5bb74922a",
		"@discordjs/ws": "3.0.0-dev.1794009739-5bb74922a",
		"pretty-ms": "^10.0.0"
	},
	"devDependencies": {
		"@tsconfig/node24": "^24.0.6",
		"@tsconfig/strictest": "^2.0.9",
		"@types/node": "^26.6.6",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"oxlint-tsgolint": "^7.0.2007",
		"typescript": "~7.0.2"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "pnpm@12.18.0"
}
